{
  "name": "yaviene-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing de Ya Viene — el bus en vivo en Barranquilla.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "presupuesto": "node scripts/presupuesto.mjs",
    "mapa": "python3 scripts/gen_mapa_landing.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}

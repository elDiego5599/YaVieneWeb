{
  "name": "yaviene-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing de Ya Viene — el bus en vivo en Barranquilla.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "presupuesto": "node scripts/presupuesto.mjs",
    "mapa": "python3 scripts/gen_mapa_landing.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
